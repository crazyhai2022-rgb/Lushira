# ---- Public (safe for the browser) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SITE_URL=http://localhost:5173
# Maps: leave VITE_MAPBOX_TOKEN empty to use OpenStreetMap tiles (no key needed)
VITE_MAPBOX_TOKEN=
# Flip to true only AFTER an SMS provider is configured in Supabase Auth (see README)
VITE_PHONE_OTP_ENABLED=false
# Public Razorpay key id (rzp_test_... / rzp_live_...). Leave empty until credentials exist.
VITE_RAZORPAY_KEY_ID=

# ---- Server-only: set these as Supabase Edge Function secrets, NEVER in the browser/Git ----
# supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=... RAZORPAY_WEBHOOK_SECRET=...
# supabase secrets set SEND_SMS_HOOK_SECRET=... SMS_PROVIDER=msg91|twilio ...
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions automatically)
